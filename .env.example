ADMIN_USER_ID=123456789
# Host-header allowlist for the web surfaces. Comma-separated bare hosts (no
# scheme, no port). Left empty, the app derives it from RAILWAY_PUBLIC_DOMAIN,
# WEB_UPLOAD_URL and WEBAPP_URL, always keeps localhost/127.0.0.1 so container
# health probes work, and only falls back to accepting any Host header - with a
# startup warning - when there is nothing to derive from. Set it in production.
ALLOWED_HOSTS=your-domain.example
ALLOWED_USER_IDS=123456789,987654321
API_HASH=your-api-hash
API_ID=123456
API_SESSION=media-converter
AUTO_FETCH_FORWARDS=true
AWS_ACCESS_KEY_ID=AKIA1234567890EXAMPLE
AWS_SECRET_ACCESS_KEY=your-secret-access-key
BOT_API_MAX_MB=50
BOT_OWNER_ID=123456789
BOT_TOKEN=123456:ABCDEF123456
BATCH_DEFER_SECONDS=10
# Seconds between live refreshes of a batch's single progress message.
BATCH_PROGRESS_INTERVAL=3
# Leave empty to inherit JOB_MAX_SECONDS.
BATCH_LOCK_TTL_SECONDS=
BIGFILE_CACHE_TTL=86400
BIGFILE_IN_MEMORY_MAX_MB=200
# How long one file of a bulk apply may take to become available locally before
# the apply gives up on it and moves to the next. Backstop only; the Pyrogram
# download below is the real bound.
BULK_FETCH_TIMEOUT_SECONDS=2700
CONVERSIONS_PER_HOUR=20
DEBUG_SECRET=change-me
# Gates the diagnostics surfaces (/metrics, the log dump, job internals) via the
# X-DIAG-TOKEN header or ?token=. They fail closed (403) when it is unset, so an
# empty value disables those routes rather than exposing them. Use a long random
# string, not the placeholder below.
DIAG_TOKEN=diag-token
DOWNLOAD_LOCATION=/tmp/downloads
DOWNLOAD_CHUNK_SIZE_KB=256
# Egress accounting (against the provider's free-egress allowance).
# EGRESS_FREE_MULTIPLIER is the provider's policy: IDrive e2 grants 3x your
# stored bytes per cycle, so emptying the bucket shrinks the allowance too.
EGRESS_FREE_MULTIPLIER=3
# Ratio of that allowance at which /session_status flags it and the admin is alerted.
EGRESS_WATCH_PERCENT=80
# Log a warning each time this much egress accumulates within one cycle.
EGRESS_WARN_STEP_GB=50
# Seconds between egress checks by the watchdog.
EGRESS_CHECK_INTERVAL=900
# Minimum seconds between two Telegram egress alerts, so a flapping ratio stays quiet.
EGRESS_ALERT_MIN_INTERVAL=3600
# Serve /docs, /redoc and /openapi.json. Off by default because they enumerate
# every route and schema to anyone who asks; 1/true/yes/on enables them.
ENABLE_API_DOCS=false
ENABLE_MEMORY_SAMPLER=false
ENABLE_TELETHON_INGEST=true
ENABLE_USERBOT=false
EVENTBUS_QUEUE_BACKEND=redis
EVENTBUS_QUEUE_ROLLOUT_PERCENT=0
EVENTBUS_EVENTS_BACKEND=off
EVENTBUS_REQUIRE_BROKERS=false
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
FILE_ID_CACHE_TTL_SECONDS=86400
FORCE_POLLING=false
GET_UPDATES_CONCURRENCY=8
GET_UPDATES_POOL_SIZE=16
GET_UPDATES_POOL_TIMEOUT=30
HTTP_POOL_SIZE=20
HTTP_POOL_TIMEOUT=30
JOB_MAX_SECONDS=3600
JOB_METADATA_TTL=86400
JOB_WAIT_SECONDS=30
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CLIENT_ID=media-bot
KAFKA_EVENTS_TOPIC=media.job.events
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=
KAFKA_EMIT_PROGRESS_EVENTS=false
KAFKA_PROGRESS_MIN_INTERVAL_MS=2000
KEEP_LOCAL_UPLOADS=true
LOGS_CHANNEL=-1007777777777
LOG_TO_STDOUT=true
MAX_CONCURRENT_TASKS=2
# One media = one stored object (inputs/library/<hash>/source), reused by every
# style/button applied to it. MEDIA_CACHE_ENABLED=0 falls back to per-job inputs.
MEDIA_CACHE_ENABLED=true
# Media identity cache lifetime, in seconds.
MEDIA_CACHE_TTL_SECONDS=86400
# Only media at or below this size are cached verbatim in Redis.
MEDIA_CACHE_BYTES_MAX_MB=32
# Only one ffmpeg process at a time, across every replica and service.
MAX_CONCURRENT_FFMPEG=1
MAX_FILE_SIZE=100
MAX_REMOTE_MISSING_ATTEMPTS=3
MINIO_ROOT_PASSWORD=strong-password
MINIO_ROOT_USER=minioadmin
MONGODB_NAME=media_converter
MONGODB_URL=mongodb://localhost:27017/media_converter
MONGO_URI=mongodb://localhost:27017/media_converter
OUTPUT_LOCATION=/tmp/output
PORT=8080
# How long a single Pyrogram download may run before it is treated as failed and
# its partial file removed. 0 disables the bound.
PIPELINE_DOWNLOAD_TIMEOUT_SECONDS=1800
# What the big-file pipeline stores for a source:
#   stream - the whole media, written to one shared object per media
#            (inputs/library/<hash>/source) *while* it downloads. A repeat is
#            then served straight from the bucket - validated with a HEAD
#            existence + size check - so it costs no Telegram traffic at all.
#            Needs a Telethon session on the ingest host; the disk/Pyrogram path
#            takes over without one.
#   header - the code default: only the first PIPELINE_HEADER_BYTES as a probe
#            reference, so the bucket never holds the video. Cheapest on stored
#            bytes, but the media still has to be read over Telegram per job.
#   full   - the whole media, uploaded once the download has finished.
#   local  - nothing is uploaded; the job is fed from the ingest's own disk.
PIPELINE_SOURCE_UPLOAD=stream
# Promote on repeat: a media whose first ingest stored only its probe header is
# stored *whole* the second time it is requested, so from then on every job reads
# the bucket instead of Telegram. First-time media keep costing 2 MB; only media
# that come back pay for a whole copy. 0 disables it (pure header behaviour).
PIPELINE_PROMOTE_ON_REPEAT=1
PREFER_USERBOT=false
PRESIGN_EXPIRES=3600
PROMETHEUS_METRICS_PORT=9090
PYROGRAM_MAX_RETRIES=10
PYROGRAM_SESSION=
PYROGRAM_SLEEP_THRESHOLD=30
QUIET_MONGO_SESSION_ERRORS=true
RABBITMQ_URL=
RABBITMQ_MAX_RETRIES=3
RABBITMQ_PREFETCH=1
RABBITMQ_RETRY_TTL_MS=30000
REDIS_URL=redis://localhost:6379/0
RELAY_CHAT_ID=-1001234567890
REMOTE_MISSING_BACKOFF_BASE=2
# Keep the uploaded source on disk so a worker in the same container reads it
# instead of downloading it back out of S3 (saves one full copy of the media of
# egress per job). 0 restores delete-immediately.
REUSE_LOCAL_INPUT=1
S3_BUCKET=my-media-bucket
# Remote-object lifetimes in seconds, applied by the hourly cleanup sweep.
# Per-job inputs / uploads / forwards / delivered results.
S3_INPUT_TTL=86400
S3_UPLOADS_TTL=86400
S3_FORWARDS_TTL=172800
S3_OUTPUTS_TTL=86400
# The shared one-object-per-media library (inputs/library/). Exempt from
# S3_INPUT_TTL on purpose: deleting it is what forced a re-download + re-upload
# of the same media, so it outlives the burst of operations on that media.
# 30 days: long enough that a media re-submitted weeks later is still a hit,
# and the stored copy also raises the provider's free-egress allowance (it is a
# multiple of what is stored). Lower it if the bucket is the binding cost.
S3_LIBRARY_TTL=2592000
# /session_status thresholds and storage scan bounds (see README).
STATUS_MEMORY_HIGH_PERCENT=80
STATUS_MEMORY_CRITICAL_PERCENT=92
STATUS_STORAGE_SCAN_MAX_OBJECTS=5000
STATUS_STORAGE_SCAN_TIMEOUT_SECONDS=20
STATUS_STORAGE_CACHE_SECONDS=300
S3_ENDPOINT=https://s3.example.com
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_USE_SSL=true
# Run the ffmpeg worker as a separate process/service. When true, delivery and
# encoding still work the same, but a separate container has no shared disk with
# the bot: REUSE_LOCAL_INPUT and the shared source cache only help within one
# container, so set this to true only if you accept that trade.
START_WORKER=false
# How long a per-cycle storage counter (egress, source-cache savings) is kept
# before Redis expires it. Without a TTL one key per cycle per counter would
# accumulate for the life of the bucket.
STORAGE_COUNTER_TTL_DAYS=60
STORAGE_BACKEND=s3
STORAGE_PATH=/data/storage
SESSION_HEALTHCHECK_INTERVAL=3600
# Telegram flood control (429 "Retry in N seconds") can last hours. A window longer
# than this many seconds is never slept off inline: progress edits are dropped and
# user-facing sends fail fast with a local RetryAfter, so a flood slows the bot
# down instead of parking a handler for the rest of the day.
TELEGRAM_FLOOD_INLINE_MAX_SECONDS=30
# The bot and the worker share one bot token and one Telegram budget, so windows
# are mirrored into Redis and each process re-reads the one it is about to act on
# at most this often. Set TELEGRAM_FLOOD_RESYNC_SECONDS=0 to read on every check.
TELEGRAM_FLOOD_RESYNC_SECONDS=1.0
# How long to stop talking to Redis after a failed flood-gate read/write, so a dead
# Redis does not add a connection attempt to every progress edit.
TELEGRAM_FLOOD_REDIS_BACKOFF_SECONDS=30
# Key namespace for the shared windows; per-bot by default (appended to this).
TELEGRAM_FLOOD_KEY_PREFIX=ffmpeg:flood:
# A job whose final status Telegram would not accept is not a finished job: the
# watcher keeps trying to write it for up to this long, then leaves the last
# message it managed rather than polling a dead chat forever.
TELEGRAM_FLOOD_TERMINAL_MAX_WAIT_SECONDS=3600
# A delivery Telegram refused during a window is queued and retried by the worker
# once the window closes, instead of being finalized as "delivery failed".
# Abandoned after this long (the local output is swept at 24h).
DEFERRED_DELIVERY_HORIZON_SECONDS=43200
DEFERRED_DELIVERY_MAX_ATTEMPTS=5
DEFERRED_DELIVERY_RETRY_BACKOFF_SECONDS=120
DEFERRED_DELIVERY_SWEEP_SECONDS=30
DEFERRED_DELIVERY_SWEEP_LIMIT=5
# How long a claimed delivery is hidden from another sweep/worker mid-send.
DEFERRED_DELIVERY_LEASE_SECONDS=600
# Progress watchers stop after ``ffmpeg:job:<id>`` has been missing this long.
WATCH_JOB_MISSING_MAX_SECONDS=600
TELETHON_CONNECTION_RETRIES=5
TELETHON_DEBUG_PORT=4444
TELETHON_DEBUG_TOKEN=debug-token
TELETHON_LISTEN_INCOMING=true
TELETHON_REQUEST_RETRIES=10
TELETHON_RETRY_DELAY=3
TELETHON_SESSION=media-converter
TELETHON_SESSION_NAME=media_converter
TELETHON_TIMEOUT=120
TEMP_UPLOAD_DIR=/tmp/uploads
THUMBNAILS_PATH=/tmp/thumbs
UPLOAD_SECRET=change-me
WEBHOOK_SECRET=change-me
# In-memory web state is bounded, because both maps are keyed by something the
# caller controls and would otherwise grow for the life of the process: the rate
# limiter holds one bucket per (endpoint, client), and the web job store holds one
# entry per fallback conversion.
WEB_RATE_LIMIT_BUCKET_TTL=600
WEB_RATE_LIMIT_MAX_BUCKETS=10000
WEB_JOB_STORE_TTL_SECONDS=3600
WEB_JOB_STORE_MAX_ENTRIES=200
WEBHOOK_URL=https://your-domain.example/webhook
WEB_HOST=0.0.0.0
WEB_UPLOAD_URL=https://upload.example.com
# Memory ceiling: the worker will not start a conversion while RSS is already
# above this many bytes, so a second ffmpeg never stacks on the previous file's
# memory. Tuned to ~75% of a 1 GB Railway container. 0 disables.
WORKER_MEMORY_CEILING_BYTES=805306368
# Standalone worker: exit for a clean container restart when RSS is still above
# this many bytes after a job's cleanup. Tuned to ~75% of a 1 GB container.
# 0 disables (default).
WORKER_RESTART_AFTER_JOB_BYTES=805306368

# For managed Kafka providers such as Aiven, store the PEM contents as a
# deployment secret. KAFKA_SSL_CAFILE takes precedence when both are set.
AIVEN_CA_CERT=
